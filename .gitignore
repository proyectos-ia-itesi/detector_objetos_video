runs/
weights/
.ultralytics/

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Base de datos local ----------
db/data/
*.sql.gz
*.sqlite
*.sqlite3

# ---------- Frontend / PHP ----------
node_modules/
vendor/

